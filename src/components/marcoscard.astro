---
import EmailIcon from './icons/email.astro'
import LinkedinIcon from './icons/linkedin.astro'
---

<div class="flex flex-col w-full pl-20">
	<div class="flex items-center gap-89">
		<h1 class="text-4xl font-semibold mt-0">Marcos Borri</h1>

		<div class="flex items-center gap-3 opacity-95">
			<img
				class="size-7"
				src="https://upload.wikimedia.org/wikipedia/commons/4/4c/Typescript_logo_2020.svg"
				alt="TypeScript"
			/>

			<img
				class="size-7"
				src="https://www.svgrepo.com/show/452088/php.svg"
				alt="PHP"
			/>

			<img
				class="size-7"
				src="https://cdn-icons-png.flaticon.com/512/18405/18405643.png"
				alt="MySQL"
			/>
		</div>
	</div>

	<p class="text-2xl opacity-80">
		Técnico Universitario en Programación y Desarrollador Web.
	</p>

	<ul class="flex gap-2 flex-wrap mt-2">
		<li>
			<a
				href="#"
				class="rounded-full border border-black/10 flex justify-center items-center bg-blue-400/5 gap-x-2 py-1 px-4 hover:scale-105 hover:bg-blue-400/20 transition"
			>
				<LinkedinIcon class="w-5 h-5" />
				LinkedIn
			</a>
		</li>
		<li>
			<a
				href="mailto:marcosborri06@gmail.com"
				class="rounded-full border border-black/10 flex justify-center items-center bg-blue-400/5 gap-x-2 py-1 px-4 hover:scale-105 hover:bg-blue-400/20 transition"
			>
				<EmailIcon class="w-5 h-5" />
				marcosborri06@gmail.com
			</a>
		</li>
	</ul>
</div>
